generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DEVELOP_DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  hashedId  String    @unique @default(cuid())
  name      String    @db.VarChar(30)
  email     String    @unique
  password  String    @db.Char(32)
  createdAt DateTime  @default(now())

  receipts Receipt[]
}

model Receipt {
  id        Int       @id @default(autoincrement())
  userId    Int
  latitude  Float
  longitude Float
  isChecked Boolean   @default(false)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  images ReceiptImage[]
}

model ReceiptImage {
  id        Int      @id @default(autoincrement())
  receiptId Int
  url       String   @db.VarChar(255)
  createdAt DateTime @default(now())

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

model Store {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(100)
  image         String?   @db.VarChar(255)
  latitude      Float?
  longitude     Float?
  googleMapLink String?   @db.VarChar(255)
  createdAt     DateTime  @default(now())
}

model Category {
  id            Int       @id @default(autoincrement())
  parentId      Int?
  name          String    @db.VarChar(50)

  parents Category? @relation("CategoryNestRelation", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryNestRelation")
}

model Product {
  id            Int       @id @default(autoincrement())
  storeId       Int
  categoryId    Int
  name          String    @db.VarChar(100)
  image         String?   @db.VarChar(255)
  price         Int
  createdAt     DateTime  @default(now())
}