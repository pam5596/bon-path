{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "baseUrl": "./src",
    "paths": {
      "@constants/*": ["constants/*"],
      "@models/*": ["models/*"],
      "@error": ["models/error"],
      "@valueObject": ["models/valueObject"],
    }
  }
}