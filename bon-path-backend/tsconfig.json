{
  "compilerOptions": {
    "experimentalDecorators": false,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@constants/*": ["./src/constants/*"],
      "@models/*": ["./src/models/*"],
      "@error": ["./src/error"],
      "@valueObject": ["./src/models/valueObject"],
      "@entity": ["./src/models/entity"],
      "@repository": ["./src/repository"],
      "@service": ["./src/service"],
      "@client": ["./src/clients"],
      "@usecase/*": ["./src/usecase/*"],
      "@share/*": ["../share/*"]
    }
  }
}