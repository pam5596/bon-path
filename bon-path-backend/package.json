{
  "name": "bon-path-backend",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "app:dev": "NODE_ENV=development dotenv -e .env.develop -e .env -- tsx watch src/run.ts",
    "app:test": "NODE_ENV=test dotenv -e .env.test -e .env -- tsx watch src/run.ts",
    "app:stage": "NODE_ENV=production dotenv -e .env -- tsx watch src/run.ts",
    "migrate:dev": "dotenv -e .env.develop -- npx prisma migrate dev",
    "migrate:test": "dotenv -e .env.test -- npx prisma migrate dev",
    "migrate:stage": "dotenv -e .env -- npx prisma migrate deploy",
    "studio:dev": "dotenv -e .env.develop -- npx prisma studio -p 5050",
    "studio:test": "dotenv -e .env.test -- npx prisma studio -p 4040",
    "generate": "npx prisma generate",
    "reset": "npx prisma reset",
    "test": "dotenv -e .env -e .env.test-- vitest"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "dotenv-cli": "^10.0.0",
    "esbuild": "^0.21.5",
    "npm-run-all2": "^6.2.0",
    "pino": "^10.0.0",
    "pino-pretty": "^13.1.2",
    "prisma": "^6.14.0",
    "tsx": "^4.20.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.894.0",
    "@hono/node-server": "^1.19.0",
    "@hono/swagger-ui": "^0.5.2",
    "@hono/zod-openapi": "^1.1.3",
    "@langchain/community": "^0.3.57",
    "@langchain/core": "^0.3.77",
    "@langchain/openai": "^0.6.13",
    "@prisma/client": "^6.14.0",
    "argon2": "^0.44.0",
    "googleapis": "^160.0.0",
    "hono": "^4.9.2",
    "langchain": "^0.3.34",
    "zod": "^4.1.11"
  }
}
